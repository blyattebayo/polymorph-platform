{
    "name": "__PLUGIN_PACKAGE__",
    "type": "library",
    "description": "__PLUGIN_NAME__ plugin for Polymorph.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "polymorph/sdk": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\__PLUGIN_CLASS__\\": "be/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\__PLUGIN_CLASS__\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "polymorph/sdk-laravel": "^2.0",
        "polymorph/plugin-test-kit": "^2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "http://127.0.0.1:8081"
        }
    ],
    "scripts": {
        "test": "vendor/bin/pest be/tests --bootstrap=vendor/autoload.php"
    },
    "config": {
        "secure-http": false,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
