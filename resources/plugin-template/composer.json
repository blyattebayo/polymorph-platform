{
    "name": "__PLUGIN_PACKAGE__",
    "type": "library",
    "description": "__PLUGIN_NAME__ plugin for Polymorph.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "blyattebayo/polymorph-sdk": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\__PLUGIN_CLASS__\\": "be/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\__PLUGIN_CLASS__\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "blyattebayo/polymorph-sdk-laravel": "^4.0",
        "blyattebayo/polymorph-plugin-test-kit": "^4.0"
    },
    "scripts": {
        "test": "vendor/bin/pest be/tests --bootstrap=vendor/autoload.php"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
